# --- Database (Neon in produzione, Postgres locale in sviluppo) ---
# Neon: usa la connection string "pooled" per l'app.
DATABASE_URL="postgresql://user:password@localhost:5432/bandi_veneto?schema=public"

# --- Scoring di rilevanza (API Anthropic) ---
ANTHROPIC_API_KEY="sk-ant-..."
# Opzionale: sovrascrive il modello usato per lo scoring.
ANTHROPIC_MODEL="claude-sonnet-4-6"

# --- Digest email (Resend) ---
RESEND_API_KEY="re_..."
DIGEST_FROM="Bandi Veneto <bandi@tuodominio.it>"
DIGEST_TO="tua@email.it"

# --- Protezione dell'endpoint cron ---
CRON_SECRET="una-stringa-lunga-e-casuale"

# --- Opzionali ---
# Base URL della fonte: si sovrascrive solo per test in locale.
BANDI_VENETO_BASE_URL="https://bandi.regione.veneto.it"
# Contatto esposto nello User-Agent dello scraper (buona educazione verso la fonte).
SCRAPER_CONTACT="tua@email.it"
# Millisecondi di attesa fra una richiesta HTTP e la successiva.
SCRAPER_DELAY_MS="1500"
# Tetto massimo di pagine percorse per fonte, per non ciclare all'infinito.
SCRAPER_MAX_PAGES="25"
